# Format staged front-end files (Prettier, then ESLint).
npx lint-staged || exit 1

# Format staged PHP with Pint.
#
# Resolve a PHP binary. Herd on Windows installs `php.bat`, which carries no
# executable bit, so `command -v php.bat` fails under the POSIX-mode `sh` that
# git runs hooks with even though the file executes fine. Probe by running it.
# Linux and macOS match the plain name first and never reach the fallback.
if command -v php >/dev/null 2>&1; then
	PHP_BIN=php
elif php.bat -v >/dev/null 2>&1; then
	PHP_BIN=php.bat
else
	PHP_BIN=
fi

# Blade templates are excluded: Pint is a PHP formatter and mangles directives.
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php' ':(exclude)*.blade.php')

if [ -n "$STAGED_PHP" ]; then
	if [ -z "$PHP_BIN" ]; then
		echo "pre-commit: no php binary on PATH, skipping Pint." >&2
		exit 1
	fi

	printf '%s\n' "$STAGED_PHP" | xargs -d '\n' "$PHP_BIN" vendor/bin/pint || exit 1
	printf '%s\n' "$STAGED_PHP" | xargs -d '\n' git add
fi
