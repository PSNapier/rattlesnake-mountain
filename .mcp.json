{
    "mcpServers": {
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest",
                "--headless",
                "--isolated",
                "--ignore-https-errors",
                "--browser",
                "chrome",
                "--viewport-size",
                "1440,900",
                "--output-dir",
                "storage/screenshots"
            ]
        }
    }
}
